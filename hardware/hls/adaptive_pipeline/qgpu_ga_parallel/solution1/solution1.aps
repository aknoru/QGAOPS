<AutoPilot:solution xmlns:AutoPilot="com.autoesl.autopilot.solution">
    <clockList>
        <clock name="default" period="10.0" default="false"/>
    </clockList>
    <Simulation argv="../ga_engine/vectors/golden_vectors.csv">
        <SimFlow name="cosim" setup="false" dumpTrace="none" optimizeCompile="false" ldflags="" mflags="" compiledLibrary="" toolName="xsim">
            <Rtl name="verilog" active="true"/>
            <Rtl name="vhdl" active="false"/>
        </SimFlow>
    </Simulation>
    <config>
        <config_export display_name="qgpu_ga_parallel_ip" format="ip_catalog" library="hls" vendor="qgpu" version="1.0"/>
    </config>
    <name>
        <value string="solution1"/>
    </name>
    <project>
        <value string="qgpu_ga_parallel"/>
    </project>
    <targetInfo>
        <TargetInfo value="xc7z020:-clg400:-1"/>
    </targetInfo>
    <libraryList>
        <library value="xilinx/zynq/zynq" name="DefaultPlatform"/>
    </libraryList>
    <flowTarget value="vivado"/>
</AutoPilot:solution>
